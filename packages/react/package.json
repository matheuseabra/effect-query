    "test": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": { "@wthw7/effect-query": "workspace:^" },
  "peerDependencies": { "effect": "^3.22.1", "react": "^18.3.1 || ^19.0.0" },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
